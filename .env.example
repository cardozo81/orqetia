# Synthetic local-development configuration only.
# Never place real provider credentials, encryption keys, or production secrets here.

ORQETIA_ENVIRONMENT=local
ORQETIA_PROCESS_ROLE=api
ORQETIA_DEBUG=true
ORQETIA_PUBLIC_BASE_URL=http://127.0.0.1:8000
ORQETIA_DATABASE_DSN=postgresql+psycopg://orqetia@postgres:5432/orqetia

# pydantic-settings parses complex values as JSON.
ORQETIA_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ORQETIA_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]

# Provider credentials are never configured here.
# Local mode is synthetic-only and forbidden in production.
ORQETIA_SECRET_STORE_MODE=local

ORQETIA_WORKER_CONCURRENCY=4
ORQETIA_WORK_LEASE_SECONDS=60
ORQETIA_QUEUE_POLL_INTERVAL_SECONDS=1
ORQETIA_SHUTDOWN_GRACE_SECONDS=30
