            "type": "string",
            "maxLength": 200
          }
        }
      },
      "AttemptSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "operation",
          "provider_id",
          "model_id",
          "status"
        ],
        "properties": {
          "attempt_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "operation": {
            "$ref": "#/components/schemas/OperationCode"
          },
          "provider_id": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "TaskView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "session_id",
          "operation",
          "status",
          "requested_execution_mode",
          "created_at",
          "attempts"
        ],
        "properties": {
          "task_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "session_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "operation": {
            "$ref": "#/components/schemas/OperationCode"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "QUEUED",
              "RUNNING",
              "PARTIAL",
              "COMPLETE",
              "UNAVAILABLE",
              "FAILED",
              "CANCELLING",
              "CANCELLED"
            ]
          },
          "requested_execution_mode": {
            "type": "string",
            "enum": [
              "AUTO",
              "EXPLICIT_TARGET"
            ]
          },
          "requested_target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Target"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Target"
              },
              {
                "type": "null"
              }
            ],
            "description": "Frozen for EXPLICIT_TARGET. AUTO actual target remains per attempt."
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttemptSummary"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "terminal_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "AttemptView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "operation",
          "provider",
          "model_id",
          "status",
          "started_at"
        ],
        "properties": {
          "attempt_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "operation": {
            "$ref": "#/components/schemas/OperationCode"
          },
          "task_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UUID"
              },
              {
                "type": "null"
              }
            ],
            "description": "Nullable only when an operation contract permits taskless execution. Never replaced with a synthetic task."
          },
          "session_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UUID"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderIdentity"
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reasoning_profile": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "status": {
            "type": "string"
          },
          "cycle": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "attempt_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "retry_of_attempt_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UUID"
              },
              {
                "type": "null"
              }
            ]
          },
          "fallback_from_attempt_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UUID"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/TechnicalUsage"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "SanitizedEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_type",
          "sanitized_raw_body",
          "sanitized_sha256",
          "truncated"
        ],
        "properties": {
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sanitized_raw_body": {
            "type": "string",
            "description": "Persisted sanitized technical evidence. Presentation layers must not semantically humanize this content."
          },
          "sanitized_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "ExchangeEvidenceView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exchange_id",
          "attempt_id",
          "provider",
          "operation",
          "request_evidence"
        ],
        "properties": {
          "exchange_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "attempt_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderIdentity"
          },
          "operation": {
            "$ref": "#/components/schemas/OperationCode"
          },
          "status": {
            "type": "string"
          },
          "status_label": {
            "type": "string",
            "description": "Humanizable metadata; never applied to raw evidence."
          },
          "request_evidence": {
            "$ref": "#/components/schemas/SanitizedEvidence"
          },
          "response_evidence": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SanitizedEvidence"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TaskResultView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "status",
          "result",
          "attempt_ids"
        ],
        "properties": {
          "task_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "status": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "accepted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempt_ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UUID"
            }
          }
        }
      },
      "EstimateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "input"
        ],
        "properties": {
          "operation": {
            "$ref": "#/components/schemas/OperationCode"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "reference_scope": {
            "type": "string",
            "enum": [
              "CLIENT_ONLY",
              "GLOBAL_PUBLIC"
            ],
            "default": "CLIENT_ONLY"
          },
          "execution": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "AUTO",
                    "default": "AUTO"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "target"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "EXPLICIT_TARGET"
                  },
                  "target": {
                    "$ref": "#/components/schemas/Target"
                  }
                }
              }
            ],
            "discriminator": {
              "propertyName": "mode"
            },
            "description": "Optional. Omission is equivalent to AUTO."
          }
        }
      },
      "EstimateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "estimated_input_tokens",
          "requested_execution_mode",
          "effective_execution_mode",
          "effective_target",
          "reference_scope",
          "estimation_method",
          "methodology_version",
          "benchmark_version",
          "as_of",
          "sample_size",
          "cohort_size",
          "confidence",
          "limitations"
        ],
        "properties": {
          "estimated_input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "estimated_cached_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "estimated_output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "estimated_reasoning_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "estimated_total_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "requested_execution_mode": {
            "type": "string",
            "enum": [
              "AUTO",
              "EXPLICIT_TARGET"
            ]
          },
          "effective_execution_mode": {
            "type": "string",
            "enum": [
              "AUTO",
              "EXPLICIT_TARGET"
            ]
          },
          "effective_target": {
            "$ref": "#/components/schemas/Target"
          },
          "reference_scope": {
            "type": "string",
            "enum": [
              "CLIENT_ONLY",
              "GLOBAL_PUBLIC"
            ]
          },
          "estimation_method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "methodology_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "benchmark_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "sample_size": {
            "type": "integer",
            "minimum": 0
          },
          "cohort_size": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "fallback_available": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "CLIENT_ONLY",
                  "GLOBAL_PUBLIC"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      },
      "ProviderPublicView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "provider_name",
          "capabilities"
