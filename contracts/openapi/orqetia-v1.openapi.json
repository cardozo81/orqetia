            "enum": [
              "ACTIVE",
              "EXPIRED",
              "CANCELLED",
              "CLOSED"
            ]
          },
          "policy_version_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "TaskCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "input"
        ],
        "properties": {
          "operation": {
            "$ref": "#/components/schemas/OperationCode"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "execution": {
            "$ref": "#/components/schemas/ExecutionSelection",
