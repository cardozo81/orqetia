{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqetia.example/contracts/execution/task-execution-selection.schema.json",
  "title": "TaskExecutionSelection",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "AUTO"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "EXPLICIT_TARGET"
        },
        "target": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "reasoning_profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "target"
      ],
      "additionalProperties": false
    }
  ]
}
