{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqetia.dev/contracts/events/envelope/v1.schema.json",
  "title": "ORQETIA EventEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "producer",
    "occurred_at",
    "aggregate_type",
    "aggregate_id",
    "data_classification",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\."
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "RESTRICTED",
        "CONFIDENTIAL",
        "CLIENT_PRIVATE",
        "INTERNAL",
        "PUBLIC"
      ]
    },
    "payload": {
      "type": "object"
    },
    "tenant_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "client_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregate_version": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_classification": {
            "const": "CLIENT_PRIVATE"
          }
        },
        "required": [
          "data_classification"
        ]
      },
      "then": {
        "required": [
          "tenant_id",
          "client_id"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  ]
}
