{
    auto_https disable_redirects
    admin off
}

http://127.0.0.1:8080 {
    respond /health/live "ok" 200
}

https://localhost:8443 {
    tls internal

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    handle_path /dev-idp/* {
        reverse_proxy local-idp:9000
    }

    @backoffice path /backoffice /backoffice/*
    handle @backoffice {
        reverse_proxy backoffice:8100
    }

    @portal path /portal /portal/*
    handle @portal {
        reverse_proxy portal:8200
    }

    handle /v1/* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    handle /health/* {
        reverse_proxy api:8000
    }

    handle {
        respond "ORQETIA local development gateway" 200
    }
}
